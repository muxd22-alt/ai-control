#!/data/data/com.termux/files/usr/bin/sh
# runit service: keep the model download alive.
#
# The phone kills Termux when it wants the memory back, and a 17 GB download
# that dies at 90% is a bad afternoon. runit restarts this the moment it
# exits, and the download itself resumes where it stopped.
AI_ROOT="${AI_ROOT:-$HOME/ai}"
if [ -f "$AI_ROOT/etc/ai.env" ]; then
  . "$AI_ROOT/etc/ai.env"
fi
MODEL="${AI_MODEL_FILE:-$AI_ROOT/models/gemma-4-26B-A4B-it-UD-Q4_K_M.gguf}"

while :; do
  if [ -f "$MODEL" ]; then
    echo "model present - the download service goes quiet"
    sleep 3600
    continue
  fi
  echo "--- download attempt $(date -u +%FT%TZ) ---"
  bash "$AI_ROOT/projects/ai-control/model-download.sh"
  echo "--- download returned $? ---"
  sleep 30
done
